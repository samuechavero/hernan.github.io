{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "homepage": "https://www.hernanelperro.com",
  "scripts": {
    "dev": "pnpm --filter @workspace/capsulas-vsl run dev",
    "build": "pnpm --filter @workspace/capsulas-vsl run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "4.64.5",
    "gh-pages": "^6.3.0",
    "lightningcss-darwin-arm64": "1.32.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
